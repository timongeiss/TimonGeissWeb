---
interface Props {
  slug: string;
  title: string;
  organization: string;
  year: string;
  tags: string[];
}

const { slug, title, organization, year, tags } = Astro.props;
---

<article class="project-card" data-project-card data-tags={JSON.stringify(tags)}>
  <div class="project-year"><time datetime={year}>{year}</time></div>
  <div class="timeline-track" aria-hidden="true"></div>
  <a href={`/projects/${slug}/`} class="project-card-link" aria-label={`Open project: ${title}`}>
    <h3>{title}</h3>
    <p>{organization}</p>
    <div class="project-card-tags" aria-label="Project keywords">
      {tags.map((tag) => <span>{tag}</span>)}
    </div>
    <span class="project-card-arrow" aria-hidden="true">→</span>
  </a>
</article>
