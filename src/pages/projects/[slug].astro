---
import { getCollection, render } from "astro:content";
import BaseLayout from "../../layouts/BaseLayout.astro";

export async function getStaticPaths() {
  const projects = await getCollection("projects");
  return projects.map((project) => ({
    params: { slug: project.data.slug },
    props: { project },
  }));
}

const { project } = Astro.props;
const { Content } = await render(project);
const isOngoing = /\b(present|today)\b/i.test(project.data.period);
---

<BaseLayout title={`${project.data.title} — Timon Geiss`}>
  <article class="project-page site-shell">
    <a class="back-link" href="/#projects">← All projects</a>
    <header class="project-header">
      <p class="eyebrow">{isOngoing ? "Ongoing project" : "Project"}</p>
      <h1>{project.data.title}</h1>
    </header>

    <div class="project-meta" aria-label="Project information">
      <div>
        <span>Period</span>
        <strong>{project.data.period}</strong>
      </div>
      <div>
        <span>Organisation / context</span>
        <strong>{project.data.organization}</strong>
      </div>
    </div>

    <div class="project-detail-grid">
      <aside class="project-aside" aria-label="Project tags">
        <section>
          <h2>Focus</h2>
          <div class="detail-tags">
            {project.data.tags.map((tag) => <span>{tag}</span>)}
          </div>
        </section>
      </aside>

      <div class="project-prose">
        <Content />

        {
          project.data.images.length > 0 && (
            <section class="project-media" aria-label="Project media">
              <h2>Project media</h2>
              <div class="media-grid">
                {project.data.images.map((image) => (
                  <figure>
                    <button
                      class="media-trigger"
                      type="button"
                      data-media-trigger
                      data-media-src={image.src}
                      data-media-alt={image.alt}
                      data-media-caption={image.caption ?? ""}
                      aria-label={`Open full-size image: ${image.alt}`}
                    >
                      <img src={image.src} alt={image.alt} loading="lazy" />
                      <span class="media-expand" aria-hidden="true">View full size ↗</span>
                    </button>
                    {image.caption && <figcaption>{image.caption}</figcaption>}
                  </figure>
                ))}
              </div>
              <dialog class="media-lightbox" data-media-lightbox aria-label="Expanded project image">
                <div class="media-lightbox-content">
                  <button class="media-lightbox-close" type="button" data-media-close>Close <span aria-hidden="true">×</span></button>
                  <img data-media-lightbox-image src="" alt="" />
                  <p data-media-lightbox-caption hidden></p>
                </div>
              </dialog>
            </section>
          )
        }

        {
          project.data.links.length > 0 && (
            <section class="project-resources" aria-label="Project resources">
              <h2>Resources</h2>
              <div class="resource-links">
                {project.data.links.map((link) => (
                  <a href={link.href} target="_blank" rel="noreferrer">
                    <span>{link.label}</span><span aria-hidden="true">↗</span>
                  </a>
                ))}
              </div>
            </section>
          )
        }
      </div>
    </div>
  </article>
</BaseLayout>

<script>
  const dialog = document.querySelector<HTMLDialogElement>("[data-media-lightbox]");
  const dialogImage = dialog?.querySelector<HTMLImageElement>("[data-media-lightbox-image]");
  const dialogCaption = dialog?.querySelector<HTMLParagraphElement>("[data-media-lightbox-caption]");
  const closeButton = dialog?.querySelector<HTMLButtonElement>("[data-media-close]");

  document.querySelectorAll<HTMLButtonElement>("[data-media-trigger]").forEach((trigger) => {
    trigger.addEventListener("click", () => {
      if (!dialog || !dialogImage) return;
      dialogImage.src = trigger.dataset.mediaSrc || "";
      dialogImage.alt = trigger.dataset.mediaAlt || "";

      if (dialogCaption) {
        const caption = trigger.dataset.mediaCaption || "";
        dialogCaption.textContent = caption;
        dialogCaption.hidden = caption.length === 0;
      }

      dialog.showModal();
    });
  });

  closeButton?.addEventListener("click", () => dialog?.close());
  dialog?.addEventListener("click", (event) => {
    if (event.target === dialog) dialog.close();
  });
</script>
