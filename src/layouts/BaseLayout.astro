---
import "../styles/global.css";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = "Timon Geiss — Vitae Portfolio",
  description = "Portfolio of projects.",
} = Astro.props;
const isHome = Astro.url.pathname === "/";
const projectLink = isHome ? "#projects" : "/#projects";
const academicLink = isHome ? "#academic" : "/#academic";
const contactLink = isHome ? "#contact" : "/#contact";
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="theme-color" content="#061c32" />
    <title>{title}</title>
  </head>
  <body>
    <header class="site-header">
      <div class="site-shell header-inner">
        <a class="site-name" href="/">Timon Geiss</a>
        <nav aria-label="Primary navigation">
          <a href="/">About</a>
          <a href={projectLink} data-portfolio-nav="projects">Projects</a>
          <a href={academicLink} data-portfolio-nav="academic">Academic Path</a>
          <a href={contactLink}>Contact</a>
        </nav>
      </div>
    </header>
    <main><slot /></main>
    <footer class="site-footer">
      <div class="site-shell footer-inner">
        <p>© {new Date().getFullYear()} Timon Geiss</p>
        <a href="https://github.com/timongeiss" target="_blank" rel="noreferrer">GitHub ↗</a>
      </div>
    </footer>
  </body>
</html>
